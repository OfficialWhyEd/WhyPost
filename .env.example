# WhyPost — API Keys
# Copia questo file in .env e compila i valori

# Pexels API (gratuito: https://www.pexels.com/api/)
PEXELS_API_KEY=

# Meta Graph API per Instagram (Settimana 5)
IG_ACCESS_TOKEN=
IG_ACCOUNT_ID=

# TikTok Content API (Settimana 6)
TT_ACCESS_TOKEN=

# Reddit API (opzionale, per scraping avanzato)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=WhyPost/1.0
