# WhyPost — variabili d'ambiente
# Copia in .env e compila con i tuoi valori reali

# ── Instagram / Meta ────────────────────────────────────────────────────────
# Da: Meta Business Suite → Settings → System Users → API Access
# Permessi richiesti: instagram_content_publish, instagram_manage_insights
IG_ACCESS_TOKEN=
IG_ACCOUNT_ID=

# ── Instagram OAuth App (per flusso OAuth automatico) ───────────────────────
# Da: Meta Developers → App → Impostazioni OAuth → App ID e Secret
IG_APP_ID=
IG_APP_SECRET=

# ── TikTok ──────────────────────────────────────────────────────────────────
# Da: TikTok Developer Portal → App → Products → Content Posting API
# Permessi: video.publish, video.upload
TT_ACCESS_TOKEN=

# ── TikTok OAuth App ────────────────────────────────────────────────────────
TT_CLIENT_KEY=
TT_CLIENT_SECRET=

# ── YouTube ──────────────────────────────────────────────────────────────────
# File OAuth: metti in data/yt_credentials.json
# Da: Google Cloud Console → APIs → YouTube Data API v3 → OAuth 2.0
# (il token viene generato automaticamente al primo run)
# YT_CLIENT_SECRET_PATH=data/yt_credentials.json   ← default, non serve impostare

# ── URL pubblico per video hosting (IG e TikTok richiedono URL pubblico) ─────
# Opzione 1: cloudflared tunnel --url http://localhost:5174  → copia URL qui
# Opzione 2: qualsiasi CDN/server pubblico
PUBLIC_BASE_URL=

# ── Pexels (B-roll gratuiti) ────────────────────────────────────────────────
# Da: pexels.com/api — piano gratuito disponibile
PEXELS_API_KEY=

# ── Pixabay (B-roll fallback) ────────────────────────────────────────────────
# Da: pixabay.com/api — piano gratuito disponibile, usato quando Pexels
# non trova risultati o la chiave Pexels non è impostata
PIXABAY_API_KEY=

# ── Reddit API (opzionale — EXEL idea engine) ───────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=WhyPost/1.0

# ── Google Calendar ──────────────────────────────────────────────────────────
# Metti credentials.json in data/gcal_credentials.json
# Da: console.cloud.google.com → APIs → Google Calendar → OAuth 2.0
